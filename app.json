{
  "expo": {
    "name": "havenly",
    "slug": "havenly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "havenly",
    "userInterfaceStyle": "light",
    "ios": {
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.kronium.havenly"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2962FF",
        "foregroundImage": "./assets/images/android-adaptive-foreground.png",
        "monochromeImage": "./assets/images/android-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.kronium.havenly"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2962FF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "@clerk/expo",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Havenly to use your photos for your profile picture."
        }
      ],
      "expo-localization",
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": false,
          "disableSPM": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2962FF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "28441699-ff42-4e5b-9cde-f8cf1ff911d2"
      }
    }
  }
}
